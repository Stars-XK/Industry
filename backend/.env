# ===================================================================
# 信创工业综合治理平台 (Industrial Comprehensive Governance Platform)
# -------------------------------------------------------------------
# 本地开发环境配置文件 (.env)
# 请将此文件复制为 `.env` 并根据本地实际环境修改相关配置参数
# ===================================================================

# -------------------------------------------------------------------
# 1. 关系型数据库配置 (PostgreSQL)
# 用于存储：RBAC、台账、配置、工单、字典等静态/低频业务数据
# -------------------------------------------------------------------
# 数据库主机地址 (本地通常为 localhost 或 127.0.0.1)
PG_HOST=localhost

# 数据库端口 (PostgreSQL 默认 5432)
PG_PORT=5432

# 数据库用户名
PG_USER=postgres

# 数据库密码
PG_PASSWORD=postgres

# 数据库名称 (确保该库已经存在)
PG_DATABASE=postgres

# -------------------------------------------------------------------
# 2. 时序数据库配置 (TDengine 3.3.8)
# 用于存储：水务、电力、环境等传感器的秒级/毫秒级高频历史时序数据
# -------------------------------------------------------------------
# TDengine RESTful API 地址
TDENGINE_HOST=139.224.26.134

# TDengine RESTful API 端口
TDENGINE_PORT=6041

# TDengine 用户名
TDENGINE_USER=root

# TDengine 密码
TDENGINE_PWD=taosdata

# TDengine 数据库名称
TDENGINE_DATABASE=dma

# TDengine REST 认证 Header
# 格式为: Basic Base64(username:password)
# root:taosdata 的 Base64 编码为: cm9vdDp0YW9zZGF0YQ==
TD_AUTH="Basic cm9vdDp0YW9zZGF0YQ=="

# -------------------------------------------------------------------
# 3. 认证与安全配置 (Auth & Security)
# -------------------------------------------------------------------
# JWT 签名密钥 (生产环境请务必修改为强随机字符串)
JWT_SECRET=super_secret_industrial_key_2024

# JWT Token 过期时间 (如: 12h, 7d)
JWT_EXPIRES_IN=12h

# -------------------------------------------------------------------
# 4. 微服务端口配置 (Microservices Ports)
# -------------------------------------------------------------------
# 认证与权限服务端口
PORT_AUTH_SERVICE=3001

# API 网关端口 (供前端调用的统一入口)
PORT_API_GATEWAY=3000

# SCADA 与组态服务端口
PORT_SCADA_SERVICE=3002

# 数据中台服务端口
PORT_DATA_CENTER=3003

# 工单与运维服务端口
PORT_WORKFLOW_SERVICE=3004

# -------------------------------------------------------------------
# 5. Redis 缓存配置 (可选/后续拓展使用)
# -------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
